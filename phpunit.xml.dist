<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd"
         bootstrap="tests/bootstrap.php" cacheDirectory=".phpunit.cache"
         colors="true" failOnWarning="true" failOnRisky="true" failOnDeprecation="true">
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="0" force="true"/>
        <env name="KERNEL_CLASS" value="App\Kernel"/>
        <env name="TYPESAFE_API_KEY" value="test-key-not-a-secret" force="true"/>
    </php>
    <testsuites><testsuite name="System One"><directory>tests</directory></testsuite></testsuites>
    <source><include><directory>src</directory></include></source>
</phpunit>
