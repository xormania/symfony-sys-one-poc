{
    "name": "xormania/symfony-sys-one-poc",
    "description": "A reproducible Symfony experiment in TypeSafe-compatible System One decisions",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "symfony/ai-bundle": "^0.14.0",
        "symfony/ai-type-safe-platform": "^0.14.0",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/runtime": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {"App\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"App\\Tests\\": "tests/"}
    },
    "config": {
        "allow-plugins": {"symfony/runtime": true},
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "style": "@php vendor/bin/php-cs-fixer check --diff",
        "verify": [
            "@composer validate --strict --check-lock",
            "@php bin/console lint:container --env=test",
            "@test",
            "@analyse",
            "@style"
        ]
    }
}
